# Backend application
CLINICAL_ENVIRONMENT=local
CLINICAL_API_HOST=127.0.0.1
CLINICAL_API_PORT=8000
CLINICAL_DEPENDENCY_TIMEOUT_SECONDS=2
CLINICAL_MAX_REQUEST_BODY_BYTES=16384
CLINICAL_WORKFLOW_RATE_LIMIT_PER_MINUTE=120
CLINICAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local dependencies (configured in Phase 0.4)
CLINICAL_DATABASE_URL=sqlite:///./data/clinical_workflow.db
CLINICAL_WORKFLOW_NODE_TIMEOUT_SECONDS=10
CLINICAL_WORKFLOW_NODE_MAX_RETRIES=1
CLINICAL_LANGSMITH_TRACING_ENABLED=false
CLINICAL_FHIR_BASE_URL=http://localhost:8080/fhir
CLINICAL_FHIR_REQUEST_TIMEOUT_SECONDS=5
CLINICAL_FHIR_MAX_RETRIES=2
CLINICAL_FHIR_RETRY_BACKOFF_SECONDS=0.1
CLINICAL_FHIR_MAX_PAGES_PER_SEARCH=5
CLINICAL_FHIR_MAX_RECORDS_PER_TYPE=500
CLINICAL_WEAVIATE_URL=http://localhost:8081
CLINICAL_WEAVIATE_GRPC_PORT=50051
CLINICAL_WEAVIATE_REQUEST_TIMEOUT_SECONDS=10
CLINICAL_GUIDELINE_CORPUS_LOCK_PATH=data/guidelines/corpus-lock.json

# Keep local startup credential-free. Select one provider only when intentionally
# exercising a grounded-generation path.
CLINICAL_LLM_PROVIDER=fake
# OpenAI settings (used when CLINICAL_LLM_PROVIDER=openai)
# CLINICAL_LLM_MODEL=gpt-5.6-sol
# CLINICAL_LLM_BASE_URL=https://api.openai.com/v1
# Anthropic settings (used when CLINICAL_LLM_PROVIDER=anthropic)
# CLINICAL_LLM_ANTHROPIC_MODEL=claude-sonnet-4-6
# CLINICAL_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Local Ollama settings (used when CLINICAL_LLM_PROVIDER=ollama; no API key)
# CLINICAL_LLM_OLLAMA_MODEL=qwen3:4b
# CLINICAL_LLM_OLLAMA_BASE_URL=http://localhost:11434
# CLINICAL_LLM_OLLAMA_CONTEXT_WINDOW=8192
# Shared provider settings
# CLINICAL_LLM_REQUEST_TIMEOUT_SECONDS=30 # use 180 for local CPU inference
# CLINICAL_LLM_MAX_RETRIES=2
# CLINICAL_LLM_MAX_OUTPUT_TOKENS=4096
# CLINICAL_LLM_REASONING_EFFORT=medium # OpenAI only
# CLINICAL_LLM_API_KEY=replace-with-a-cloud-provider-secret
